# Site Instituto Simples — rotas (Apache / LiteSpeed da Hostinger)
Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS (o certificado SSL da Hostinger é gratuito)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Código e arquivos internos nunca são servidos
  RewriteRule ^(app|frontend)(/|$) - [F,L]
  RewriteRule (^|/)\.(git|env|github) - [F,L]
  RewriteRule \.(md|json|lock|sql|log)$ - [F,L,NC]

  # API
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # Páginas do site e do painel (React): tudo que não é arquivo vai para index.html.
  # Arquivos inexistentes com extensão (ex.: imagem) continuam dando 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Arquivos com hash no nome podem ficar em cache por 1 ano; a página inicial nunca.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf|eot|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
