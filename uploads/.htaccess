# Só imagens: nada aqui é executado como script
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
