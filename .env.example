# Copie para .env (teste local). Na Hostinger, importe este conteúdo no passo
# "Environment variables" do deploy (opção "Import from .env file").
# NÃO defina PORT (a Hostinger atribui) e NÃO defina NODE_ENV.

# ---- Banco MariaDB ----
# Na Hostinger: host "localhost", porta 3306 e os nomes COMPLETOS criados no hPanel
# (eles têm prefixo, ex.: u123456789_isdg).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_isdg
DB_USER=u123456789_isdg
DB_PASSWORD=SENHA_DO_BANCO

# ---- Primeiro administrador ----
# Usado SÓ se ainda não existir nenhum usuário. Depois do 1º acesso, REMOVA ADMIN_PASSWORD.
ADMIN_NAME=Administrador
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=

# ---- Imagens enviadas pelo painel ----
# Pasta FORA do código (cada deploy apaga as pastas do app). Na Hostinger, crie a pasta
# "isdg-uploads" no Gerenciador de Arquivos, no mesmo nível da pasta "domains".
UPLOAD_DIR=/home/u123456789/isdg-uploads
MAX_UPLOAD_MB=5

# ---- Opcionais ----
# SITE_TIMEZONE=America/Sao_Paulo   # fuso usado para esconder eventos passados da Agenda
# RESET_ADMIN=1                     # recuperar acesso: com ADMIN_EMAIL + ADMIN_PASSWORD, redefine a senha (remova depois)
